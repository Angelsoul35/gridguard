# Copy to .env and adjust. All variables are optional; defaults are safe for local use.

# Robust z-score (median + MAD) above which an hour's consumption is flagged as a
# consumption spike. Higher = fewer, more extreme spikes.
GG_SPIKE_Z_THRESHOLD=5.0

# Minimum length, in hours, of a zero/constant run before it is flagged as an
# outage or a stuck (flatlined) meter.
GG_FLATLINE_MIN_RUN=6

# A meter reading (smoothed over a few hours) sustained below this fraction of its
# own seasonal baseline is treated as a possible sustained drop (theft / loss).
# Injected theft reaches ~0.72 of the load, so the threshold sits just above it.
GG_THEFT_FRACTION=0.80

# Minimum length, in hours, of a sustained drop before it is flagged as theft.
GG_THEFT_MIN_RUN=12

# Minimum correlation between the dropped window and the house's daily shape for a
# drop to count as theft. Theft scales the profile (shape kept); an empty-house
# vacation flattens it (shape lost), so this separates theft from a vacation.
GG_THEFT_SHAPE_CORR_MIN=0.5

# Optional learned model layered on top of the deterministic rules:
# "logistic" (supervised), "isolation_forest" (unsupervised), or "none".
GG_MODEL_KIND=logistic

# Confidence gate for the learned layer: the model only adds a flag when its
# anomaly probability is at least this high, so it supplements the rules' recall
# without flooding false positives. (Does not apply to isolation_forest.)
GG_MODEL_MIN_PROBA=0.9

# Rolling-window length, in hours, used by the windowed features.
GG_ROLLING_WINDOW=24
